#!/usr/bin/env bash
# Human-facing ZAOS front door.  Capability enforcement remains in
# zaos-session; this script only discovers context and selects its profile.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)
AGENTS_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)
CONFIG_FILE="${ZAOS_SHIM_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zaos-native/config.sh}"
[ -r "$CONFIG_FILE" ] && source "$CONFIG_FILE"
WORKSPACE_ROOT="${ZAOS_WORKSPACE_ROOT:-$(cd "$AGENTS_ROOT/.." && pwd -P)}"
SESSION_BIN=${ZAOS_SESSION_BIN:-"$SCRIPT_DIR/zaos-session"}

usage() {
  cat >&2 <<'EOF'
usage: zaos [codex|claude] [PROJECT_PATH] [--local-dev|--remote-git|--external-publish] [-- ENGINE_ARGS...]
       zaos {doctor|engines|update}

Start a ZAOS session for the current Git project.  At the ZAOS workspace root,
the default is framework maintenance.  Use --local-dev only when the task needs
the project's local services (database, RAGFlow, UAT, and similar).

Examples:
  zaos
  zaos codex
  zaos claude
  zaos codex /path/to/project --local-dev
  zaos codex /path/to/project --remote-git
  zaos codex --external-publish
EOF
}

case "${1:-}" in
  doctor) shift; exec "$AGENTS_ROOT/engines/tools/zaos-doctor" "$@" ;;
  engines) shift; exec "$AGENTS_ROOT/engines/bin/zaos-engines" "$@" ;;
  update) shift; exec "$AGENTS_ROOT/engines/bin/zaos-update" "$@" ;;
esac
engine=codex
engine_set=0
project_arg=""
local_dev=0
remote_git=0
external_publish=0
print_plan=0
engine_args=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    codex|terra|claude)
      if [ -n "$project_arg" ] || [ "$engine_set" = 1 ]; then
        printf 'zaos: engine may be specified once\n' >&2; usage; exit 64
      fi
      engine=$1; engine_set=1; shift ;;
    --local-dev) local_dev=1; shift ;;
    --remote-git) remote_git=1; shift ;;
    --external-publish) external_publish=1; shift ;;
    --print-plan) print_plan=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; engine_args=("$@"); break ;;
    -*)
      printf 'zaos: unknown option: %s\n' "$1" >&2; usage; exit 64 ;;
    *)
      if [ -n "$project_arg" ]; then
        printf 'zaos: specify at most one project path\n' >&2; usage; exit 64
      fi
      project_arg=$1; shift ;;
  esac
done

if [ $((local_dev + remote_git + external_publish)) -gt 1 ]; then
  printf 'zaos: --local-dev, --remote-git, and --external-publish are mutually exclusive\n' >&2
  exit 64
fi

resolve_git_project() {
  local candidate=$1 resolved
  if [ ! -d "$candidate" ]; then
    printf 'zaos: project path is not a directory: %s\n' "$candidate" >&2
    exit 65
  fi
  resolved=$(realpath -e "$candidate")
  if ! project_root=$(git -C "$resolved" rev-parse --show-toplevel 2>/dev/null); then
    printf 'zaos: project path must be inside a Git worktree: %s\n' "$resolved" >&2
    exit 65
  fi
  project_root=$(realpath -e "$project_root")
}

if [ -n "$project_arg" ]; then
  resolve_git_project "$project_arg"
elif git -C "$PWD" rev-parse --show-toplevel >/dev/null 2>&1; then
  resolve_git_project "$PWD"
elif [ "$(pwd -P)" = "$WORKSPACE_ROOT" ]; then
  # The workspace itself is deliberately not a Git repo.  Its maintained
  # framework lives in the adjacent .agents worktree.
  resolve_git_project "$AGENTS_ROOT"
else
  printf 'zaos: no Git project found from %s; pass a project path (for example: zaos codex /path/to/project)\n' "$(pwd -P)" >&2
  exit 65
fi

# Canonical, opt-in per-project capability declaration: a project that needs
# FULL_LOCAL_DEV (DB/RAGFlow/UAT-class local services) says so itself in
# <project-root>/.zaos-capability (first non-blank, non-comment line, case
# insensitive). This lets FULL_LOCAL_DEV be requested from project/task
# metadata instead of a human-remembered flag, without hardcoding any project
# name here. Absence means no elevated capability.
declared_capability() {
  local root=$1 f="$1/.zaos-capability" line
  [ -f "$f" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line=$(printf '%s' "$line" | tr -d '[:space:]')
    [ -n "$line" ] || continue
    printf '%s' "$line" | tr '[:lower:]' '[:upper:]'
    return 0
  done < "$f"
}

agents_repo=$(git -C "$AGENTS_ROOT" rev-parse --show-toplevel 2>/dev/null || true)
if [ "$external_publish" = 1 ]; then
  # Explicit, task-scoped egress for publication/release work. This is never
  # selected by project name or by simply starting a maintenance session.
  mode=ZAOS_EXTERNAL_PUBLISH
elif [ "$remote_git" = 1 ]; then
  # Explicit, task-scoped egress for remote Git and GitHub operations. It is
  # deliberately narrower than public/external publication.
  mode=ZAOS_REMOTE_GIT
elif [ "$project_root" = "$agents_repo" ]; then
  mode=ZAOS_MAINTENANCE
elif [ "$local_dev" = 1 ]; then
  mode=FULL_LOCAL_DEV
elif [ "$(declared_capability "$project_root")" = "FULL_LOCAL_DEV" ]; then
  mode=FULL_LOCAL_DEV
else
  mode=NORMAL_MUTATIVE_PROJECT
fi

case "$engine" in
  codex|terra) internal_engine=codex ;;
  claude) internal_engine=claude ;;
esac

if [ "$print_plan" = 1 ]; then
  printf 'ZAOS_PROJECT=%s\nZAOS_ENGINE=%s\nZAOS_CAPABILITY=%s\n' "$project_root" "$engine" "$mode"
  exit 0
fi

exec "$SESSION_BIN" "$mode" "$internal_engine" "$project_root" -- "${engine_args[@]}"
