#!/usr/bin/env bash
# Launch a bounded ZAOS engine session.  This is intentionally a small router,
# not a second permission framework.
set -euo pipefail

# Resolve from this tracked script so a relocated/copied ZAOS workspace keeps
# working.  The public launcher uses the same discovery; this internal router
# deliberately retains no machine-specific workspace path.
SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)
ZAOS_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)
CONFIG_FILE="${ZAOS_SHIM_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/zaos-native/config.sh}"
[ -r "$CONFIG_FILE" ] && source "$CONFIG_FILE"
default_runtime_root="${XDG_STATE_HOME:-$HOME/.local/state}/zaos/engines"
# Existing ZAOS workspaces kept disposable engine state beside `.agents`.
# Prefer it when present; new portable installs use the XDG-style default.
[ -d "$ZAOS_ROOT/../.runtime/engines" ] && default_runtime_root="$ZAOS_ROOT/../.runtime/engines"
RUNTIME_ROOT="${ZAOS_RUNTIME_ROOT:-$default_runtime_root}"

# Recursion guard: when the native-command shims are installed (see
# bin/zaos-install-native-shims), the plain names "codex"/"claude" on PATH
# resolve back to the shim, not the vendor binary. Prefer the shim's stable
# copy of the real binary so this router can never call itself. Falls back to
# PATH resolution (unshimmed environments, tests) when that copy is absent.
default_real_bin_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zaos/real-bin"
# v1 used this location. Keep existing working machines operational while new
# installs use the XDG-style location above.
[ -d "$HOME/.local/lib/zaos-real-bin" ] && default_real_bin_dir="$HOME/.local/lib/zaos-real-bin"
real_bin_dir="${ZAOS_REAL_BIN_DIR:-$default_real_bin_dir}"
resolve_engine_bin() {
  local name=$1
  if [ -x "$real_bin_dir/$name" ]; then
    printf '%s' "$real_bin_dir/$name"
  else
    printf '%s' "$name"
  fi
}

usage() {
  printf '%s\n' "usage: zaos-session {READ_ONLY|NORMAL_MUTATIVE_PROJECT|FULL_LOCAL_DEV|ZAOS_MAINTENANCE|ZAOS_EXTERNAL_PUBLISH} {codex|claude} PROJECT_ROOT [-- ENGINE_ARGS...]" >&2
  exit 64
}

# FULL_LOCAL_DEV capability preflight (task-class-scoped, engine-neutral).
# Fails fast with CAPABILITY_BLOCKED rather than letting an agent discover a
# missing capability after minutes of work. Required loopback endpoints are
# the Zandi local dev stack (Postgres, RAGFlow, UAT gateway); override with
# ZAOS_FULL_LOCAL_DEV_PORTS="host:port,..." if a project needs a different set.
full_local_dev_preflight() {
  local root="$1" gd="$2" probe_ports port host testfile hp
  testfile="$root/.zaos-preflight-$$"
  if ! ( : > "$testfile" ) 2>/dev/null; then
    printf 'CAPABILITY_BLOCKED: filesystem write — %s is not writable\n' "$root" >&2
    exit 75
  fi
  rm -f "$testfile"
  if [ ! -w "$gd" ]; then
    printf 'CAPABILITY_BLOCKED: git index write — %s is not writable\n' "$gd" >&2
    exit 75
  fi
  probe_ports="${ZAOS_FULL_LOCAL_DEV_PORTS:-127.0.0.1:5442,127.0.0.1:19381,127.0.0.1:8090}"
  local IFS=,
  for hp in $probe_ports; do
    host="${hp%%:*}"; port="${hp##*:}"
    if ! timeout 3 bash -c "cat < /dev/null > /dev/tcp/$host/$port" 2>/dev/null; then
      printf 'CAPABILITY_BLOCKED: loopback service unreachable — %s\n' "$hp" >&2
      exit 75
    fi
  done
}

external_publish_preflight() {
  # Publication needs the same local transaction capability as maintenance;
  # actual DNS/auth is deliberately left to the vendor/git command so this
  # profile does not treat a network probe as proof of authorization.
  local root="$1" gd="$2" testfile="$1/.zaos-publish-preflight-$$"
  if ! ( : > "$testfile" ) 2>/dev/null; then
    printf 'CAPABILITY_BLOCKED: filesystem write — %s is not writable\n' "$root" >&2
    exit 75
  fi
  rm -f "$testfile"
  if [ ! -w "$gd" ]; then
    printf 'CAPABILITY_BLOCKED: git index write — %s is not writable\n' "$gd" >&2
    exit 75
  fi
}

[ "$#" -ge 3 ] || usage
mode=$1
engine=$2
requested_root=$3
shift 3
[ "${1:-}" != "--" ] || shift

project_root=$(git -C "$requested_root" rev-parse --show-toplevel) || {
  printf '%s\n' "zaos-session: PROJECT_ROOT must resolve to a Git worktree" >&2
  exit 65
}
project_root=$(realpath -e "$project_root")
git_dir=$(git -C "$project_root" rev-parse --absolute-git-dir)
git_dir=$(realpath -e "$git_dir")

case "$mode" in
  READ_ONLY)
    ;;
  NORMAL_MUTATIVE_PROJECT|FULL_LOCAL_DEV)
    case "$project_root/" in
      "$ZAOS_ROOT/"*)
        printf '%s\n' "zaos-session: use ZAOS_MAINTENANCE for .agents repositories" >&2
        exit 65
        ;;
    esac
    [ "$mode" = "FULL_LOCAL_DEV" ] && full_local_dev_preflight "$project_root" "$git_dir"
    ;;
  ZAOS_MAINTENANCE)
    case "$project_root/" in
      "$ZAOS_ROOT/"*) ;;
      *)
        printf '%s\n' "zaos-session: ZAOS_MAINTENANCE is limited to .agents repositories" >&2
        exit 65
        ;;
    esac
    ;;
  ZAOS_EXTERNAL_PUBLISH)
    external_publish_preflight "$project_root" "$git_dir"
    ;;
  *) usage ;;
esac

case "$engine" in
  codex)
    codex_bin=$(resolve_engine_bin codex)
    case "$mode" in
      READ_ONLY)
        exec env CODEX_HOME="$RUNTIME_ROOT/codex" "$codex_bin" --sandbox read-only -C "$project_root" "$@"
        ;;
      NORMAL_MUTATIVE_PROJECT|ZAOS_MAINTENANCE)
        # Codex excludes Git metadata from workspace-write.  The CLI-supported
        # add-dir grants only the resolved metadata directory, including a
        # worktree or gitdir-indirection target.
        exec env CODEX_HOME="$RUNTIME_ROOT/codex" "$codex_bin" --sandbox workspace-write -C "$project_root" --add-dir "$git_dir" "$@"
        ;;
      FULL_LOCAL_DEV)
        # Same filesystem/git scope as NORMAL_MUTATIVE_PROJECT. Codex's
        # workspace-write sandbox additionally denies ALL network syscalls
        # (loopback included) unless network_access is explicitly set; this
        # is the one extra grant FULL_LOCAL_DEV needs over the normal
        # project route. Filesystem containment (writable_roots) is
        # unaffected by this key — verified: writes outside the workdir
        # still fail read-only under this override.
        exec env CODEX_HOME="$RUNTIME_ROOT/codex" "$codex_bin" --sandbox workspace-write -C "$project_root" --add-dir "$git_dir" -c 'sandbox_workspace_write.network_access=true' "$@"
        ;;
      ZAOS_EXTERNAL_PUBLISH)
        # Explicit release/publication egress; filesystem scope remains the
        # project plus its Git metadata exactly as maintenance does.
        exec env CODEX_HOME="$RUNTIME_ROOT/codex" "$codex_bin" --sandbox workspace-write -C "$project_root" --add-dir "$git_dir" -c 'sandbox_workspace_write.network_access=true' "$@"
        ;;
    esac
    ;;
  claude)
    claude_bin=$(resolve_engine_bin claude)
    cd "$project_root"
    case "$mode" in
      READ_ONLY)
        exec env CLAUDE_CONFIG_DIR="$RUNTIME_ROOT/claude" "$claude_bin" --permission-mode plan --permission-prompts none "$@"
        ;;
      NORMAL_MUTATIVE_PROJECT|ZAOS_MAINTENANCE|FULL_LOCAL_DEV|ZAOS_EXTERNAL_PUBLISH)
        # Claude's supported path scopes the session to its cwd plus this
        # resolved Git directory; do not use bypassPermissions. Claude's
        # sandbox does not restrict network syscalls in any mode, so no
        # extra grant is needed here for loopback access.
        exec env CLAUDE_CONFIG_DIR="$RUNTIME_ROOT/claude" "$claude_bin" --permission-mode auto --permission-prompts none --add-dir "$git_dir" "$@"
        ;;
    esac
    ;;
  *) usage ;;
esac
