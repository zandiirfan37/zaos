#!/usr/bin/env bash
# Scoped native-command transparency: install (or remove) user-local shims at
# `codex` and `claude` on PATH that transparently route through ZAOS only when
# the current directory is inside this ZAOS-managed workspace, and behave as
# the exact, unmodified vendor binary everywhere else.
#
# This is a launcher UX patch, not a second orchestration framework: see
# ../SESSION_PROVISIONING.md and ../README.md. `zaos` / `zaos-session` remain
# the explicit admin/debug/escape interfaces.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd -P)
AGENTS_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd -P)

BIN_DIR="${ZAOS_SHIM_BIN_DIR:-$HOME/.local/bin}"
DEFAULT_REAL_BIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zaos/real-bin"
[ -d "$HOME/.local/lib/zaos-real-bin" ] && DEFAULT_REAL_BIN_DIR="$HOME/.local/lib/zaos-real-bin"
REAL_BIN_DIR="${ZAOS_REAL_BIN_DIR:-$DEFAULT_REAL_BIN_DIR}"
CONFIG_DIR="${ZAOS_SHIM_CONFIG_DIR:-$HOME/.config/zaos-native}"
CONFIG_FILE="$CONFIG_DIR/config.sh"
MARKER='# zaos-native-shim v1'

usage() {
  cat >&2 <<'EOF'
usage: zaos-install-native-shims [install|uninstall|status]

install    Move the real codex/claude binaries to a stable, non-PATH location
           and install scoped shims at their original names.
uninstall  Restore the original codex/claude entries and remove the shims.
status     Report what is currently installed.

Env overrides (mainly for tests): ZAOS_SHIM_BIN_DIR, ZAOS_REAL_BIN_DIR,
ZAOS_SHIM_CONFIG_DIR.
EOF
}

is_shim() {
  [ -f "$1" ] || return 1
  head -n2 "$1" 2>/dev/null | grep -qF "$MARKER"
}

write_shim() {
  local name=$1 verb=$2 path="$BIN_DIR/$name"
  cat > "$path" <<EOF
#!/usr/bin/env bash
$MARKER ($name)
# Installed by .agents/engines/bin/zaos-install-native-shims. Do not hand-edit;
# re-run the installer instead. See ../../SESSION_PROVISIONING.md.
set -euo pipefail

real_bin="\${ZAOS_REAL_BIN_DIR:-$REAL_BIN_DIR}/$name"

# Recursion guard / explicit escape hatch: once ZAOS has taken over routing,
# or when a caller explicitly asks to bypass it, go straight to the vendor
# binary. Never routes through this shim a second time.
if [ -n "\${ZAOS_INTERNAL_EXEC:-}" ]; then
  exec "\$real_bin" "\$@"
fi

config="\${ZAOS_SHIM_CONFIG_FILE:-$CONFIG_FILE}"
agents_root="\${ZAOS_AGENTS_ROOT:-}"
if [ -z "\$agents_root" ] && [ -r "\$config" ]; then
  # shellcheck source=/dev/null
  source "\$config"
  agents_root="\${ZAOS_AGENTS_ROOT:-}"
fi

# Fail open to the exact vendor binary if ZAOS isn't configured, resolvable,
# or executable — never block the native command on a broken wrapper.
if [ -z "\$agents_root" ] || [ ! -x "\$agents_root/engines/bin/zaos" ] || [ ! -x "\$real_bin" ]; then
  exec "\$real_bin" "\$@"
fi

# install.sh records the user's managed workspace independently from the
# framework checkout.  A cloned framework may live anywhere, so deriving the
# workspace from agents_root's parent would route the wrong tree.
workspace_root="\${ZAOS_WORKSPACE_ROOT:-}"
if [ -n "\$workspace_root" ] && [ -d "\$workspace_root" ]; then
  workspace_root=\$(cd "\$workspace_root" && pwd -P) || exec "\$real_bin" "\$@"
else
  # Backward-compatible layout for pre-v2 configurations that had only the
  # conventional <workspace>/.agents checkout and no workspace setting.
  workspace_root=\$(cd "\$agents_root/.." 2>/dev/null && pwd -P) || exec "\$real_bin" "\$@"
fi
cwd=\$(pwd -P) || exec "\$real_bin" "\$@"

case "\$cwd/" in
  "\$workspace_root"/*|"\$workspace_root/"|"\$agents_root/"|"\$agents_root/"*)
    ;;
  *)
    # Outside the ZAOS-managed workspace: exact vendor behavior, unmodified.
    exec "\$real_bin" "\$@"
    ;;
esac

exec env ZAOS_INTERNAL_EXEC=1 "\$agents_root/engines/bin/zaos" $verb -- "\$@"
EOF
  chmod +x "$path"
}

install_admin_entrypoint() {
  local path="$BIN_DIR/zaos" source="$AGENTS_ROOT/engines/bin/zaos"
  if [ ! -e "$path" ] || [ "$(readlink -f "$path" 2>/dev/null || true)" = "$source" ]; then
    ln -sfn "$source" "$path"
    printf 'installed admin entrypoint: %s\n' "$path"
  else
    printf 'zaos-install-native-shims: existing %s was not changed\n' "$path" >&2
  fi
}

do_install() {
  mkdir -p "$BIN_DIR" "$REAL_BIN_DIR" "$CONFIG_DIR"
  install_admin_entrypoint

  for name in codex claude; do
    local_path="$BIN_DIR/$name"
    if is_shim "$local_path"; then
      printf 'zaos-install-native-shims: %s already shimmed, skipping\n' "$name" >&2
      continue
    fi
    resolved=$(command -v "$name" 2>/dev/null || true)
    if [ -z "$resolved" ]; then
      printf 'zaos-install-native-shims: %s not found on PATH, skipping\n' "$name" >&2
      continue
    fi
    if [ "$resolved" != "$local_path" ]; then
      printf 'zaos-install-native-shims: %s resolves to %s, not %s — refusing to guess, skipping\n' \
        "$name" "$resolved" "$local_path" >&2
      continue
    fi
    if [ ! -e "$REAL_BIN_DIR/$name" ]; then
      mv "$local_path" "$REAL_BIN_DIR/$name"
    fi
    write_shim "$name" "$([ "$name" = codex ] && echo codex || echo claude)"
    printf 'installed shim: %s (real binary preserved at %s)\n' "$local_path" "$REAL_BIN_DIR/$name"
  done

  # Preserve a workspace selected by install.sh while refreshing only the
  # framework pointer. This file contains paths, never secrets.
  local retained_workspace=""
  [ -r "$CONFIG_FILE" ] && source "$CONFIG_FILE"
  retained_workspace="${ZAOS_WORKSPACE_ROOT:-}"
  cat > "$CONFIG_FILE" <<EOF
# Generated by zaos-install-native-shims. Safe to hand-edit or override per
# invocation with ZAOS_AGENTS_ROOT. Points at the canonical .agents root whose
# parent directory is treated as the ZAOS-managed workspace.
ZAOS_AGENTS_ROOT="$AGENTS_ROOT"
ZAOS_WORKSPACE_ROOT="$retained_workspace"
ZAOS_REAL_BIN_DIR="$REAL_BIN_DIR"
EOF
  printf 'wrote config: %s\n' "$CONFIG_FILE"
}

do_uninstall() {
  if [ "$(readlink -f "$BIN_DIR/zaos" 2>/dev/null || true)" = "$AGENTS_ROOT/engines/bin/zaos" ]; then
    rm -f "$BIN_DIR/zaos"
    printf 'removed admin entrypoint: %s\n' "$BIN_DIR/zaos"
  fi
  for name in codex claude; do
    local_path="$BIN_DIR/$name"
    if ! is_shim "$local_path"; then
      printf 'zaos-install-native-shims: %s is not a ZAOS shim, leaving untouched\n' "$name" >&2
      continue
    fi
    rm -f "$local_path"
    if [ -e "$REAL_BIN_DIR/$name" ]; then
      mv "$REAL_BIN_DIR/$name" "$local_path"
      printf 'restored: %s\n' "$local_path"
    fi
  done
}

do_status() {
  for name in codex claude; do
    local_path="$BIN_DIR/$name"
    if is_shim "$local_path"; then
      printf '%s: shimmed (real binary at %s/%s)\n' "$name" "$REAL_BIN_DIR" "$name"
    elif [ -e "$local_path" ]; then
      printf '%s: not shimmed (vendor entry at %s)\n' "$name" "$local_path"
    else
      printf '%s: not found at %s\n' "$name" "$local_path"
    fi
  done
  [ -r "$CONFIG_FILE" ] && printf 'config: %s\n' "$CONFIG_FILE" || printf 'config: none\n'
}

cmd="${1:-status}"
case "$cmd" in
  install) do_install ;;
  uninstall) do_uninstall ;;
  status) do_status ;;
  -h|--help) usage ;;
  *) usage; exit 64 ;;
esac
